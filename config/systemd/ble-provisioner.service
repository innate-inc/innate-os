[Unit]
Description=BLE WiFi Provisioning Service
# Start after the network stack is ready, but doesn't require full network connection
After=network.target bluetooth.service
Wants=bluetooth.service
# The advertised name is read from /etc/innate.env once, at start — so on a factory
# robot the seed has to land before this service, not whenever ros-app gets there.
# Wants=, never Requires=: the seed exits 1 on anything without a device-tree serial.
Wants=innate-seed.service
After=innate-seed.service

[Service]
# Run service manager as root, but execute command as jetson1 via sudo
# User=jetson1 # Removed
# Group=jetson1 # Removed

# Set INNATE_OS_ROOT environment variable
Environment="INNATE_OS_ROOT=/home/jetson1/innate-os"

# Set working directory if the script relies on relative paths
# WorkingDirectory=/home/jetson1/innate-os/ros2_ws/src/mars_bot/mars_bt_provisioner/mars_bt_provisioner # Removed for testing

# Path to the Python executable and the script, run via sudo -u
# Use the specific Python environment if necessary (e.g., virtualenv)
# Ensure the command path is absolute if using sudo
# Preserve common environment variables that might be needed
ExecStart=/usr/bin/sudo -u jetson1 --preserve-env=PATH,PYTHONPATH,LD_LIBRARY_PATH,INNATE_OS_ROOT -- /bin/bash -c 'sleep 10; exec /usr/bin/env python3 ${INNATE_OS_ROOT}/ros2_ws/src/mars_bot/mars_bt_provisioner/mars_bt_provisioner/simple_bt_service.py'

# --- Simplified ExecStart for debugging USER directive (Commented out) ---
# ExecStart=/bin/echo "BLE Service Test Execution"

# Restart the service if it crashes
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Log output to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target 
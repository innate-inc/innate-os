# Keep Cloud Build source uploads small and deterministic for simulator images.
# The dependency image only needs Dockerfile + apt manifests; the ROS-prebuilt
# image only needs ros2_ws/src.

.git/
.venv/
build/
install/
log/
sim/launcher/.state/
sim/.venv/

**
!.dockerignore
!.github/
!ci/
!ci/**
!sim/
!sim/Dockerfile
!sim/Dockerfile.ros-prebuilt
!sim/Dockerfile.ros-prebuilt.dockerignore
!ros2_ws/
!ros2_ws/apt-dependencies.common.txt
!ros2_ws/apt-dependencies.sim.txt
!ros2_ws/apt-dependencies.hardware.txt
!ros2_ws/pip-requirements.txt
!scripts/
!scripts/update/
!scripts/update/setup_repos.sh
!ros2_ws/src/
!ros2_ws/src/**
# Needed by ci/Dockerfile.test (COPY config/, workspace/, and webapp/proxy/).
!config/
!config/**
!workspace/
!workspace/**
!webapp/
!webapp/proxy/
!webapp/proxy/**
# The demo image (sim/demo/Dockerfile) copies these whole.
!webapp/**
!scripts/**
!sim/demo/
!sim/demo/**
!sim/props/
!sim/props/**
!sim/challenges/
!sim/challenges/**
!sim/environments/
!sim/environments/**
__pycache__/
*.pyc

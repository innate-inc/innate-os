# Environment configuration.
#
# Secrets + environment-only settings live here. Tunable ROS parameters (driving speed,
# camera, TTS voice, …) and extra agent/skill dirs live in config/settings.yaml;
# simulator settings in sim/config.toml.

# --- Secrets ---
# INNATE_SERVICE_KEY (Innate proxy access) is written to your local .env by
# `./innate setup` / `./innate-sim setup` and seeded to /etc/innate.env on update —
# it is never kept as a line in this template.
#
# The robot's brain (the local Gemini agent loop in brain_client) reaches
# Gemini through the Innate proxy using INNATE_SERVICE_KEY — no Gemini key
# needed. GEMINI_API_KEY is the standalone fallback (e.g. sim without a
# service key), talking to Google directly.
# GEMINI_API_KEY=

# GEMINI_MODEL overrides the brain's model (default gemini-3.6-flash).
# GEMINI_MODEL=

# An OpenAI-compatible server instead of Gemini — a vLLM or Ollama on a computer
# on your network, or NVIDIA's hosted NIM API. The URL and the model are robot
# settings (Settings → AI models, i.e. llm_base_url / gemini_model in
# config/settings.yaml); only the key is a secret and lives here. LLM_BASE_URL
# is the .env way to set the URL (settings.yaml wins over it).
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Cloud endpoints (all read from the environment; set by default) ---
# TELEMETRY_URL=https://logs.svc.innate.bot
# UNINAVID_WS_URL=wss://uninavid-v1.svc.innate.bot
# INNATE_PROXY_URL=https://proxy-v1.svc.innate.bot
# INNATE_AUTH_URL=https://auth-v1.svc.innate.bot
# INNATE_TRAINING_URL=https://training-v1.svc.innate.bot

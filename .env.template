# Environment configuration.
#
# Secrets + environment-only settings live here. Tunable ROS parameters (driving speed,
# camera, TTS voice, …) and extra agent/skill dirs live in config/settings.yaml;
# simulator settings in sim/config.toml.

# --- Secrets ---
# INNATE_SERVICE_KEY (Innate proxy access) is written to your local .env by
# `./innate setup` / `./innate-sim setup` and seeded to /etc/innate.env on update —
# it is never kept as a line in this template.
#
# The robot's brain (the local agent loop in brain_client) speaks Chat
# Completions and nothing else. It reaches Gemini through the Innate proxy
# using INNATE_SERVICE_KEY — no Gemini key needed. GEMINI_API_KEY is the
# standalone fallback (e.g. sim without a service key), talking to Google's
# OpenAI-compatible layer directly.
# GEMINI_API_KEY=

# Any other OpenAI-compatible server — a vLLM or Ollama on the LAN, NVIDIA's
# hosted NIM, OpenAI — is the same wire at a different URL. Point the brain at
# one with LLM_BASE_URL (its /v1 root) and LLM_API_KEY (that server's key, if it
# wants one); an endpoint set here wins over the proxy and GEMINI_API_KEY.
#   LLM_BASE_URL=http://192.168.1.20:8000/v1
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_BASE_URL=

# LLM_MODEL overrides the brain's model (default gemini-3.6-flash); GEMINI_MODEL
# is still honoured for robots that set it. config/settings.yaml wins over both:
# llm_model / llm_base_url / llm_thinking / llm_extra_body under brain_client_node
# are what Settings → AI models writes.
# LLM_MODEL=

# --- Cloud endpoints (all read from the environment; set by default) ---
# TELEMETRY_URL=https://logs.svc.innate.bot
# UNINAVID_WS_URL=wss://uninavid-v1.svc.innate.bot
# INNATE_PROXY_URL=https://proxy-v1.svc.innate.bot
# INNATE_AUTH_URL=https://auth-v1.svc.innate.bot
# INNATE_TRAINING_URL=https://training-v1.svc.innate.bot

# Environment configuration.
#
# Secrets + environment-only settings live here. Tunable ROS parameters (driving speed,
# camera, TTS voice, …) and extra agent/skill dirs live in config/settings.yaml;
# simulator settings in sim/config.toml.

# --- Secrets ---
# INNATE_SERVICE_KEY (Innate proxy access) is written to your local .env by
# `./innate setup` / `./innate-sim setup` and seeded to /etc/innate.env on update —
# it is never kept as a line in this template.
#
# The robot's brain (the local agent loop in brain_client) reaches its model
# through the Innate proxy using INNATE_SERVICE_KEY — no vendor key needed.
# A vendor key is the standalone fallback (e.g. sim without a service key),
# talking to the vendor directly; Claude uses its key first until the proxy
# serves it.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LLM_MODEL picks the brain's model as provider:name (default google:gemini-3.6-flash):
# google:gemini-3.6-flash · anthropic:claude-sonnet-5 · openai:gpt-5.4-mini
# LLM_MODEL=
# A LAN or hosted OpenAI-compatible server (vLLM, Ollama, NVIDIA NIM): its /v1 root and key.
# LLM_BASE_URL=
# LLM_API_KEY=

# --- Cloud endpoints (all read from the environment; set by default) ---
# TELEMETRY_URL=https://logs.svc.innate.bot
# UNINAVID_WS_URL=wss://uninavid-v1.svc.innate.bot
# INNATE_PROXY_URL=https://proxy-v1.svc.innate.bot
# INNATE_AUTH_URL=https://auth-v1.svc.innate.bot
# INNATE_TRAINING_URL=https://training-v1.svc.innate.bot

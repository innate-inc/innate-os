# training data
data/
!sim/data/
!sim/data/.gitignore

# User-created scripts live under workspace/custom_*/ and stay local to the machine.
# Directories are recreated at runtime by ensure_user_directories().
workspace/custom_agents/
workspace/custom_skills/
# Regenerated from the skills on this robot on every change; per-machine, not source.
workspace/physical_skills/

# Runtime start_training resume markers (innate_training_node).
workspace/.training_pending/

# Per-machine challenge state, written at runtime.
workspace/challenges.json

# Per-skill persistent key-value stores (Skill.storage, skills/types.py).
workspace/skill_storage/

# Generated on-robot by the skill catalog (typed physical-skill refs).
workspace/physical_skills/

# recordings folder
recordings/

#other werid files
*.mp4

logs

data/.last_map
data/.last_mode
.onnx

# arm_wave directory (local data, not tracked)
arm_wave/

.vscode
workspace/innate_skills/**/*.engine

node_modules/
dist-lib/
*.tsbuildinfo

# sim: uv venv + generated apartment assets (hulls, textured rooms -- sim/tools outputs)
sim/.venv/
sim/assets
sim/sandbox/__pycache__/
MUJOCO_LOG.TXT
# sim: fetched asset bundle (see ci/build_assets_image.sh); the launcher
# extracts these on `up`
sim/viewer/public/
sim/viewer/assets/
sim/.sim-assets.tmp*

# boot sounds: WAV assets fetched by post_update.sh from GCS (too heavy for git)
config/sounds/*.wav
config/sounds/motor_voices/*.wav

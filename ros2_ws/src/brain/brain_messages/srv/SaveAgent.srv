# Write an agent file into workspace/custom_agents and reload the roster.
# `source` non-empty writes the file verbatim (tooling; the webapp form never sends it);
# otherwise the file is rendered from the form fields. Shipped agents and ids
# already on the roster under another file are refused.
# Request
string id                 # snake_case identifier — the file is custom_agents/<id>.py
string display_name
string prompt
string[] skill_ids
bool listen               # microphone input
bool gaze                 # person-tracking gaze
string source             # verbatim file content; empty = render from the fields above
---
# Response
bool success              # the file was written (the agent may still have failed to load)
string message            # the load error when it did not load, else empty
string path
string source             # the file content written

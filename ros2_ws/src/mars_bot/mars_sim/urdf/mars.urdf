<?xml version="1.0"?>
<robot name="mars_bot">
  <!-- Materials -->
  <material name="matt_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="bright_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <!-- base_footprint: ground-plane frame (identity with base_link) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_laser: lidar sensor frame -->
  <link name="base_laser"/>
  <joint name="base_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_laser"/>
    <origin xyz="-0.0764 0.0 0.17165" rpy="0 0 0"/>
  </joint>

  <!-- base_link is the root of the URDF tree -->
  <!-- The odom -> base_link transform is published by bringup.py -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.89"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/base.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: the chassis block plus every part of base.STL that sticks
         out of it. Measured off the mesh; see sim/sandbox/README.md. -->
    <!-- Chassis: box 187.8mm x 182mm x 167.6mm, front face 35.2mm forward -->
    <collision name="base_chassis">
      <origin xyz="-0.0587 0 0.0838" rpy="0 0 0"/>
      <geometry>
        <box size="0.1878 0.182 0.1676"/>
      </geometry>
    </collision>
    <!-- Rear tray: overhangs the chassis by 76mm, the robot's furthest-back point -->
    <collision name="base_rear_tray">
      <origin xyz="-0.1895 0 0.0466" rpy="0 0 0"/>
      <geometry>
        <box size="0.0789 0.1658 0.0594"/>
      </geometry>
    </collision>
    <!-- Drive wheels: 74.4mm across, 7mm proud of the chassis on each side.
         The robot's widest point, so what actually catches on door frames. -->
    <collision name="base_wheel_left">
      <origin xyz="0 0.0877 0.0372" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0372" length="0.021"/>
      </geometry>
    </collision>
    <collision name="base_wheel_right">
      <origin xyz="0 -0.0877 0.0372" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0372" length="0.021"/>
      </geometry>
    </collision>
    <!-- Arm mount: bracket forward of the chassis on the arm's side -->
    <collision name="base_arm_mount">
      <origin xyz="0.0636 -0.0545 0.0391" rpy="0 0 0"/>
      <geometry>
        <box size="0.0672 0.0384 0.0443"/>
      </geometry>
    </collision>
    <!-- Lidar turret on the chassis lid -->
    <collision name="base_turret">
      <origin xyz="-0.0527 0 0.1828" rpy="0 0 0"/>
      <geometry>
        <box size="0.1255 0.104 0.0304"/>
      </geometry>
    </collision>
    <!-- Neck: the arch carrying the head, in two segments up to z=272mm.
         Without it the head's collision box floats free of the body. -->
    <collision name="base_neck_lower">
      <origin xyz="-0.0357 0 0.2155" rpy="0 0 0"/>
      <geometry>
        <box size="0.051 0.0854 0.039"/>
      </geometry>
    </collision>
    <collision name="base_neck_upper">
      <origin xyz="-0.0466 0 0.2533" rpy="0 0 0"/>
      <geometry>
        <box size="0.0374 0.036 0.0366"/>
      </geometry>
    </collision>
  </link>

  <!-- joint1 → link1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child  link="link1"/>
    <origin xyz="0.086 -0.05285 0.04025" rpy="0 0 0"/>
    <axis  xyz="0 0 1"/>
    <dynamics damping="5"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.065"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link1.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: stepped bracket, 3 boxes (54% of the enclosing box's volume) -->
    <collision name="link1_hub">
      <origin xyz="0.0089 0 0.0003" rpy="0 0 0"/>
      <geometry>
        <box size="0.0403 0.0226 0.0466"/>
      </geometry>
    </collision>
    <collision name="link1_plate">
      <origin xyz="-0.0046 0 0.0303" rpy="0 0 0"/>
      <geometry>
        <box size="0.0672 0.04 0.0133"/>
      </geometry>
    </collision>
    <collision name="link1_yoke">
      <origin xyz="-0.012 0 0.0477" rpy="0 0 0"/>
      <geometry>
        <box size="0.0465 0.04 0.0216"/>
      </geometry>
    </collision>
  </link>

  <!-- joint2 → link2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child  link="link2"/>
    <origin xyz="0 0 0.04425" rpy="0 0 0"/>
    <axis  xyz="0 1 0"/>
    <dynamics damping="5"/>
    <limit lower="-1.5708" upper="1.22" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.080"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link2.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: upper-arm shaft + elbow boss, 3 boxes (55% of the enclosing
         box). The boss reaches x=39.5mm, past the shaft the old single box
         covered. -->
    <collision name="link2_shoulder">
      <origin xyz="0 0 0.0207" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.054 0.0763"/>
      </geometry>
    </collision>
    <collision name="link2_shaft">
      <origin xyz="-0.0009 0 0.0806" rpy="0 0 0"/>
      <geometry>
        <box size="0.0244 0.0475 0.0436"/>
      </geometry>
    </collision>
    <collision name="link2_elbow">
      <origin xyz="0.0147 0 0.1204" rpy="0 0 0"/>
      <geometry>
        <box size="0.0496 0.04 0.0361"/>
      </geometry>
    </collision>
  </link>

  <!-- joint3 → link3 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child  link="link3"/>
    <origin xyz="0.02825 0 0.12125" rpy="0 0 0"/>
    <axis  xyz="0 1 0"/>
    <dynamics damping="5"/>
    <limit lower="-1.5708" upper="1.7453" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.055"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link3.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: tapered forearm, 3 boxes. The old single box stopped at
         x=117mm, leaving the last 30mm of the beam (the part nearest whatever
         the arm reaches into) with no collision at all. -->
    <collision name="link3_root">
      <origin xyz="0.0165 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0677 0.054 0.035"/>
      </geometry>
    </collision>
    <collision name="link3_mid">
      <origin xyz="0.0644 0 0.002" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.0467 0.031"/>
      </geometry>
    </collision>
    <collision name="link3_shaft">
      <origin xyz="0.1127 0 0.0035" rpy="0 0 0"/>
      <geometry>
        <box size="0.0686 0.0359 0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- joint4 → link4 -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child  link="link4"/>
    <origin xyz="0.1375 0 0.0045" rpy="0 0 0"/>
    <axis  xyz="0 1 0"/>
    <dynamics damping="5"/>
    <limit lower="-1.9199" upper="1.7453" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.022"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link4.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: box 32mm x 39mm x 20mm, the mesh's own extents -->
    <collision name="link4_body">
      <origin xyz="0.006 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.039 0.020"/>
      </geometry>
    </collision>
  </link>

  <!-- joint5 → link5 -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child  link="link5"/>
    <origin xyz="0.019 0 0" rpy="0 0 0"/>
    <axis  xyz="1 0 0"/>
    <dynamics damping="5"/>
    <limit lower="-1.5708" upper="1.5708" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.050"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link5.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: box 54mm x 44mm x 93mm, the mesh's own extents -->
    <collision name="link5_body">
      <origin xyz="0.027 0 0.031" rpy="0 0 0"/>
      <geometry>
        <box size="0.054 0.044 0.093"/>
      </geometry>
    </collision>
  </link>

  <!-- joint6 → link61 (main gripper finger) -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child  link="link61"/>
    <origin xyz="0.044 -0.0092 0" rpy="0 0 0"/>
    <axis  xyz="0 0 -1"/>
    <dynamics damping="5"/>
    <!-- Canonical (unflipped) range: negation of the real follower servo's
         raw position_limits [-0.8727, 0.3491] (arm_config.yaml joint_6).
         arm_control.cpp negates joint6 both reading encoders and writing
         goals, so 0 = closed, +0.8727 = fully open in this (and every other
         software) convention. See leaderArmMapping.ts's header comment. -->
    <limit lower="0" upper="0.8727" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="link61">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link61.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: the blade is a curved hook, and one bounding box across it
         leaves the closed fingertips 2.4mm apart so nothing can be pinched.
         What replaces it is a pivot pin, 8 boxes stepping along the hook, and
         4 more across the pad. Both chains follow one rule: the surface the
         object touches stays smooth, and all the discretisation goes on the
         back where nothing touches it.

         Hook boxes are yawed to the local grip-side surface, not to whatever
         minimises their area. A min-area box is free to rotate, and over a
         curving span it settles diagonally and bulges up to 3.3mm into the
         jaw opening; a sphere rolls straight off that ridge.

         The pad is a wedge: its inner face is a flat plane 9.25mm off the
         blade axis right to the tip while the BACK tapers from 8.8mm thick to
         2.8mm. Its 4 steps all share that one plane, so the grip face is a
         single continuous surface. Any seam in it (min-area boxes per step,
         or a split anywhere along it) loses the ball.

         Together this leaves 8% of the enclosed volume outside the real blade
         (one box for the whole thing: 30%), 0.5mm of overhang on average.
         link62 mirrors it all in y; the blade is a constant-height extrusion
         (38.90mm to the tip), so every box is full depth. -->
    <collision name="link61_hub">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0101" length="0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg1">
      <origin xyz="0.0070 -0.0012 0" rpy="0 0 -0.7857"/>
      <geometry>
        <box size="0.0138 0.0112 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg2">
      <origin xyz="0.0120 -0.0030 0" rpy="0 0 -0.3401"/>
      <geometry>
        <box size="0.0073 0.0099 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg3">
      <origin xyz="0.0165 -0.0032 0" rpy="0 0 -0.1611"/>
      <geometry>
        <box size="0.0054 0.0083 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg4">
      <origin xyz="0.0209 -0.0028 0" rpy="0 0 -0.0133"/>
      <geometry>
        <box size="0.0043 0.0070 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg5">
      <origin xyz="0.0251 -0.0021 0" rpy="0 0 0.1358"/>
      <geometry>
        <box size="0.0051 0.0059 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg6">
      <origin xyz="0.0294 -0.0009 0" rpy="0 0 0.2739"/>
      <geometry>
        <box size="0.0059 0.0052 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg7">
      <origin xyz="0.0337 0.0005 0" rpy="0 0 0.4329"/>
      <geometry>
        <box size="0.0069 0.0052 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_seg8">
      <origin xyz="0.0383 0.0027 0" rpy="0 0 0.6999"/>
      <geometry>
        <box size="0.0092 0.0056 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_pad1">
      <origin xyz="0.0411 0.0049 0" rpy="0 0 0.0000"/>
      <geometry>
        <box size="0.0022 0.0088 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_pad2">
      <origin xyz="0.0433 0.0054 0" rpy="0 0 0.0000"/>
      <geometry>
        <box size="0.0022 0.0076 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_pad3">
      <origin xyz="0.0455 0.0061 0" rpy="0 0 0.0000"/>
      <geometry>
        <box size="0.0022 0.0062 0.0389"/>
      </geometry>
    </collision>
    <collision name="link61_pad4">
      <origin xyz="0.0477 0.0070 0" rpy="0 0 0.0000"/>
      <geometry>
        <box size="0.0022 0.0045 0.0389"/>
      </geometry>
    </collision>
  </link>

  <!-- joint6M → link62 (mirrored gripper finger, geared with joint6) -->
  <joint name="joint6M" type="revolute">
    <parent link="link5"/>
    <child  link="link62"/>
    <origin xyz="0.044 0.0091 0" rpy="0 0 0"/>
    <axis  xyz="0 0 -1"/>
    <dynamics damping="5"/>
    <!-- Mirrors joint6 (multiplier -1), so its achievable range is joint6's
         negated: [-0.8727, 0]. -->
    <limit lower="-0.8727" upper="0" effort="2.0" velocity="2.0"/>
    <mimic joint="joint6" multiplier="-1" offset="0"/>
  </joint>
  <link name="link62">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/link62.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: link61's blade boxes mirrored in y (see link61) -->
    <collision name="link62_hub">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0101" length="0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg1">
      <origin xyz="0.0070 0.0012 0" rpy="0 0 0.7857"/>
      <geometry>
        <box size="0.0138 0.0112 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg2">
      <origin xyz="0.0120 0.0030 0" rpy="0 0 0.3401"/>
      <geometry>
        <box size="0.0073 0.0099 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg3">
      <origin xyz="0.0165 0.0032 0" rpy="0 0 0.1611"/>
      <geometry>
        <box size="0.0054 0.0083 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg4">
      <origin xyz="0.0209 0.0028 0" rpy="0 0 0.0133"/>
      <geometry>
        <box size="0.0043 0.0070 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg5">
      <origin xyz="0.0251 0.0021 0" rpy="0 0 -0.1358"/>
      <geometry>
        <box size="0.0051 0.0059 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg6">
      <origin xyz="0.0294 0.0009 0" rpy="0 0 -0.2739"/>
      <geometry>
        <box size="0.0059 0.0052 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg7">
      <origin xyz="0.0337 -0.0005 0" rpy="0 0 -0.4329"/>
      <geometry>
        <box size="0.0069 0.0052 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_seg8">
      <origin xyz="0.0383 -0.0027 0" rpy="0 0 -0.6999"/>
      <geometry>
        <box size="0.0092 0.0056 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_pad1">
      <origin xyz="0.0411 -0.0049 0" rpy="0 0 -0.0000"/>
      <geometry>
        <box size="0.0022 0.0088 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_pad2">
      <origin xyz="0.0433 -0.0054 0" rpy="0 0 -0.0000"/>
      <geometry>
        <box size="0.0022 0.0076 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_pad3">
      <origin xyz="0.0455 -0.0061 0" rpy="0 0 -0.0000"/>
      <geometry>
        <box size="0.0022 0.0062 0.0389"/>
      </geometry>
    </collision>
    <collision name="link62_pad4">
      <origin xyz="0.0477 -0.0070 0" rpy="0 0 -0.0000"/>
      <geometry>
        <box size="0.0022 0.0045 0.0389"/>
      </geometry>
    </collision>
  </link>

  <!-- End Effector Link -->
  <joint name="ee_joint" type="fixed">
    <parent link="link5"/>
    <child  link="ee_link"/>
    <origin xyz="0.091838 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ee_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
  </link>

  <!-- fixed camera link -->
  <joint name="fixed_arm_camera_link" type="fixed">
    <parent link="link5"/>
    <child  link="arm_camera_link"/>
    <origin xyz="0.03378 0 0.05052" rpy="0 0.43633 0"/>
  </joint>
  <link name="arm_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- for simulation you can attach a Gazebo camera plugin here -->
  </link>

  <!-- Head Link -->
  <joint name="joint_head" type="revolute">
    <parent link="base_link"/>
    <child  link="head"/>
    <origin xyz="-0.040751 -0.0002 0.25882" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="5"/>
    <limit lower="-0.3491" upper="0.6109" effort="2.0" velocity="2.0"/>
  </joint>
  <link name="head">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.148"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mars_sim/meshes/head.STL" scale="1 1 1"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
    <!-- Collision: box 113mm x 121mm x 36mm, the mesh's own extents -->
    <collision name="head_body">
      <origin xyz="0.007 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.113 0.121 0.036"/>
      </geometry>
    </collision>
  </link>

  <!-- Head Camera Left Link -->
  <joint name="fixed_head_camera_left" type="fixed">
    <parent link="head"/>
    <child  link="head_camera_left"/>
    <origin xyz="0.04327 0.0297 -0.000275" rpy="0 0 0"/>
  </joint>
  <link name="head_camera_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
  </link>

  <!-- Camera Optical Frame (at left camera, used for depth/pointcloud) -->
  <!-- Optical frame convention: Z forward, X right, Y down -->
  <joint name="fixed_camera_optical_frame" type="fixed">
    <parent link="head_camera_left"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- Head Camera Right Link -->
  <joint name="fixed_head_camera_right" type="fixed">
    <parent link="head"/>
    <child  link="head_camera_right"/>
    <origin xyz="0.04327 -0.0303 -0.000275" rpy="0 0 0"/>
  </joint>
  <link name="head_camera_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="matt_black"/>
    </visual>
  </link>
<joint name="fixed_right_camera_optical_frame" type="fixed">
  <parent link="head_camera_right"/>
  <child link="right_camera_optical_frame"/>
  <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
</joint>
<link name="right_camera_optical_frame"/>
</robot>

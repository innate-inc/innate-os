# Goal: natural-language navigation instruction
string instruction
# Policy server for this run: "10.0.0.4", "10.0.0.4:8900" or a full URL.
# Empty keeps the node's configured default.
string server
---
# Result: whether the goal completed or was pre-empted
bool success
string message
---
# Feedback: latest action code received from the server
int32 latest_action
int32 consecutive_stops
int32 max_consecutive_stops
